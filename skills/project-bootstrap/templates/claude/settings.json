{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge*)"
    ],
    "ask": ["Bash(git push)", "Bash(git push *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-remote.mjs",
            "timeout": 10,
            "statusMessage": "リモート操作を確認中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/remind-test-edit.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
